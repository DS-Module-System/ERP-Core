{% import 'default_templates/form_table_macro.html.twig' as form_table %}

<div class="modal-dialog" role="document">
    <div class="mt-3 mb-2 {% if not form.vars.valid %}was-validated{% endif %}">
        
        {% include default_templates/form_main_error.html.twig' %}
        {% set error = app.flashes('warning') %}
        {% if error %}
            {% for message in error %}
            <div class="alert alert-warning alert-dismissible fade show contact-response-output" role="alert"
                aria-hidden="true">
                {{ message }}
            </div>
            {% endfor %}
        {% endif %}
        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'api-form'}}) }}
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="searchFormLabel">Редактиране на файл</h5>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="api-error alert alert-danger"></div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        {{ form_table.tr(form.originalName) }}
                        {{ form_table.tr(form.altText) }}
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                {{ form_widget(form.save, {"attr": {"class": "btn btn-success api-save", "data-url": path('file_api_save', app.request.attributes.get('_route_params')) }}) }}
            </div>
        </div>
        {{ form_end(form, {'render_rest': false}) }}
    </div>
</div>