{% extends 'base.html.twig' %}

{% import 'core/default_templates/form_table_macro.html.twig' as form_table %}

{% set form_btns = form_table.btns('user_list', form, false) %}

{% block body %}
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    {{ form_row(form._token) }}
    <div class="row">
        <div class="col-md-12 col-lg-9">
            <div class="card">
                <div class="card-body">
                    <h4 class="header-title">{{ 'user.editPasswordTitle'|dtrans }}</h4>
                    {{ form_btns }}
                    <div class="mt-4 mb-4 {% if not form.vars.valid %}was-validated{% endif %}">
                        {% include 'core/default_templates/form_main_error.html.twig' %}
                        <div class="form-group ds-form-group mb-4">
                            {{ 'user.email'|dtrans }}
                            <div class="form-control ds-form-control">{{ user.email }}</div>
                        </div>
                        <div class="form-group ds-form-group mb-3">
                            {{ form_label(form.password) }}
                            <div class="input-group ds-input-group input-group-merge">
                                {% set hasError = (form_errors(form.password)) ? ' is-invalid': '' %}
                                {% set attrClass = 'form-control ds-form-control' %}
                                {% set attrClass = attrClass~hasError %}
                                {% if(form.password.vars.attr.class is defined) %}
                                    {% set attrClass = attrClass~' ' ~ form.password.vars.attr.class %}
                                {% endif %}
                                {{ form_widget(form.password, {"attr":{'class':attrClass}}) }}
                                <div class="input-group-text" data-password="false">
                                    <span class="password-eye"></span>
                                </div>
                                <button class="btn btn-outline-secondary" type="button" id="GenerateRandomPassword">Generate</button>
                                <div class="invalid-feedback">{{ form_errors(form.password) }}</div>
                            </div>
                        </div>
                    </div>
                    {{ form_btns }}
                </div>
            </div>
        </div>
    </div>
    {{ form_end(form, {'render_rest': false}) }}
{% endblock %}
